#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# release — Version-bump, build cross-platform binaries, tag, push,
#            and create a GitHub Release with attached binaries
#
# Usage:
#   ./release              # bump patch, build, tag, push, create release
#   ./release --dry-run    # preview without making any changes
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/VERSION"
MODULE="libro"

DRY_RUN=false

# Parse flags
for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        *)
            echo "Unknown flag: $arg"
            echo "Usage: ./release [--dry-run]"
            exit 1
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

info()  { echo -e "\033[1;34m==>\033[0m $*"; }
ok()    { echo -e "\033[1;32m==>\033[0m $*"; }
warn()  { echo -e "\033[1;33m==>\033[0m $*"; }
err()   { echo -e "\033[1;31m==>\033[0m $*" >&2; }

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------

if [[ ! -f "$VERSION_FILE" ]]; then
    err "VERSION file not found at $VERSION_FILE"
    exit 1
fi

if ! command -v gh &>/dev/null; then
    err "GitHub CLI (gh) is required. Install: https://cli.github.com"
    exit 1
fi

# ---------------------------------------------------------------------------
# Read current version and auto-bump patch
# ---------------------------------------------------------------------------

CURRENT_VERSION=$(cat "$VERSION_FILE" | tr -d '[:space:]')
info "Current version: $CURRENT_VERSION"

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"
TAG="v${NEW_VERSION}"

info "New version:     $NEW_VERSION"

# ---------------------------------------------------------------------------
# Build matrix
# ---------------------------------------------------------------------------

PLATFORMS=(
    "linux/amd64"
    "linux/arm64"
    "darwin/amd64"
    "darwin/arm64"
    "windows/amd64"
)

LDFLAGS="-X ${MODULE}/internal/version.Version=${NEW_VERSION}"
BUILD_DIR="$SCRIPT_DIR/dist"

# ---------------------------------------------------------------------------
# Dry-run mode
# ---------------------------------------------------------------------------

if [[ "$DRY_RUN" == true ]]; then
    warn "DRY RUN — no changes will be made"
    echo ""
    echo "  Version bump:  $CURRENT_VERSION → $NEW_VERSION"
    echo "  VERSION file:  $VERSION_FILE"
    echo ""
    echo "  Builds:"
    for platform in "${PLATFORMS[@]}"; do
        OS="${platform%/*}"
        ARCH="${platform#*/}"
        EXT=""; [[ "$OS" == "windows" ]] && EXT=".exe"
        echo "    ${MODULE}-${OS}-${ARCH}${EXT}"
    done
    echo ""
    echo "  Git commit:    git add VERSION && git commit -m \"$TAG\""
    echo "  Git tag:       git tag $TAG"
    echo "  Git push:      git push && git push --tags"
    echo ""
    echo "  GitHub release: gh release create $TAG --generate-notes <binaries...>"
    echo ""
    exit 0
fi

# ---------------------------------------------------------------------------
# Cleanup & tidy
# ---------------------------------------------------------------------------

info "Cleaning up..."
rm -f "$SCRIPT_DIR/libro"
go mod tidy
ok "Clean"

# ---------------------------------------------------------------------------
# Write new version
# ---------------------------------------------------------------------------

echo "$NEW_VERSION" > "$VERSION_FILE"
ok "VERSION file updated to $NEW_VERSION"

# ---------------------------------------------------------------------------
# Build all platforms
# ---------------------------------------------------------------------------

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"

for platform in "${PLATFORMS[@]}"; do
    OS="${platform%/*}"
    ARCH="${platform#*/}"
    EXT=""
    [[ "$OS" == "windows" ]] && EXT=".exe"

    OUTPUT="${BUILD_DIR}/${MODULE}-${OS}-${ARCH}${EXT}"
    info "Building ${OS}/${ARCH}..."

    # Embed Windows resources if building for Windows and go-winres is available
    if [[ "$OS" == "windows" ]] && command -v go-winres &>/dev/null; then
        (cd "$SCRIPT_DIR" && go-winres make --product-version="${NEW_VERSION}" --file-version="${NEW_VERSION}")
    fi

    CGO_ENABLED=0 GOOS="$OS" GOARCH="$ARCH" \
        go build -ldflags "$LDFLAGS" -o "$OUTPUT" .

    # Cleanup .syso files after Windows build
    [[ "$OS" == "windows" ]] && rm -f "$SCRIPT_DIR/"*.syso
done

ok "All binaries built in $BUILD_DIR"

# ---------------------------------------------------------------------------
# Git commit, tag, and push
# ---------------------------------------------------------------------------

info "Committing version bump..."
git add "$VERSION_FILE"
git commit -m "${TAG}"
git tag "${TAG}"
ok "Committed and tagged ${TAG}"

info "Pushing to remote..."
git push
git push --tags
ok "Pushed"

# ---------------------------------------------------------------------------
# Create GitHub Release
# ---------------------------------------------------------------------------

info "Creating GitHub release ${TAG}..."

ASSETS=()
for f in "$BUILD_DIR"/*; do
    ASSETS+=("$f")
done

gh release create "${TAG}" "${ASSETS[@]}" \
    --title "${TAG}" \
    --generate-notes

ok "GitHub release created: ${TAG}"

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

rm -rf "$BUILD_DIR"
ok "Build artifacts cleaned up"

echo ""
echo "============================================"
echo "  Release complete"
echo "  $CURRENT_VERSION → $NEW_VERSION"
echo "  https://github.com/michalCapo/libro/releases/tag/${TAG}"
echo "============================================"
echo ""
