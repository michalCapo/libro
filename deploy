#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# deploy — Version-bump, build, commit, and tag libro
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/VERSION"
MODULE="libro"

DRY_RUN=false

# Parse flags
for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        *)
            echo "Unknown flag: $arg"
            echo "Usage: ./deploy [--dry-run]"
            exit 1
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

info()  { echo -e "\033[1;34m==>\033[0m $*"; }
ok()    { echo -e "\033[1;32m==>\033[0m $*"; }
warn()  { echo -e "\033[1;33m==>\033[0m $*"; }
err()   { echo -e "\033[1;31m==>\033[0m $*" >&2; }

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------

if [[ ! -f "$VERSION_FILE" ]]; then
    err "VERSION file not found at $VERSION_FILE"
    exit 1
fi

# ---------------------------------------------------------------------------
# Read current version and auto-bump patch
# ---------------------------------------------------------------------------

CURRENT_VERSION=$(cat "$VERSION_FILE" | tr -d '[:space:]')
info "Current version: $CURRENT_VERSION"

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"

info "New version:     $NEW_VERSION"

# ---------------------------------------------------------------------------
# Dry-run mode — show what would happen and exit
# ---------------------------------------------------------------------------

if [[ "$DRY_RUN" == true ]]; then
    warn "DRY RUN — no changes will be made"
    echo ""
    echo "  Version bump:  $CURRENT_VERSION → $NEW_VERSION"
    echo "  VERSION file:  $VERSION_FILE"
    echo ""
    echo "  Build:         go build -ldflags \"-X $MODULE/internal/version.Version=$NEW_VERSION\" -o libro ."
    echo ""
    echo "  Git commit:    git add VERSION && git commit -m \"v$NEW_VERSION\""
    echo "  Git tag:       git tag v$NEW_VERSION"
    echo "  Git push:      git push && git push --tags"
    echo ""
    exit 0
fi

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

info "Cleaning up..."
rm -f "$SCRIPT_DIR/libro"
go mod tidy
ok "Clean"

# ---------------------------------------------------------------------------
# Write new version
# ---------------------------------------------------------------------------

echo "$NEW_VERSION" > "$VERSION_FILE"
ok "VERSION file updated to $NEW_VERSION"

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

LDFLAGS="-X ${MODULE}/internal/version.Version=${NEW_VERSION}"

# Embed Windows resources if go-winres is available
if command -v go-winres &>/dev/null; then
    info "Embedding Windows resources..."
    (cd "$SCRIPT_DIR" && go-winres make --product-version="${NEW_VERSION}" --file-version="${NEW_VERSION}")
    ok "Windows resources generated"
fi

info "Building libro (production, port 8100)..."
go build -ldflags "$LDFLAGS" -o "$SCRIPT_DIR/libro" .
ok "libro built"

# Cleanup .syso files
rm -f "$SCRIPT_DIR/"*.syso

# ---------------------------------------------------------------------------
# Git commit, tag, and push
# ---------------------------------------------------------------------------

info "Committing version bump..."
git add "$VERSION_FILE"
git commit -m "v${NEW_VERSION}"
git tag "v${NEW_VERSION}"
ok "Committed and tagged v${NEW_VERSION}"

info "Pushing to remote..."
git push
git push --tags
ok "Pushed"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

echo ""
echo "============================================"
echo "  Deploy complete"
echo "  $CURRENT_VERSION → $NEW_VERSION"
echo "============================================"
echo ""
